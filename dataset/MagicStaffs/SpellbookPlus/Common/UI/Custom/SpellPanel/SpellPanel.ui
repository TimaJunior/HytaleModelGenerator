$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@TitleStyle = LabelStyle(
  FontSize: 15,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5
);

@SpellTitleStyle = LabelStyle(
  FontSize: 22,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #b4c8c9,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5
);

@StatLabelStyle = LabelStyle(
  FontSize: 13,
  TextColor: #96a9be,
  VerticalAlignment: Center,
  RenderUppercase: true
);

@StatValueStyle = LabelStyle(
  FontSize: 13,
  RenderBold: true,
  VerticalAlignment: Center
);

@SlotWidth = 144;
@SlotHeight = 176;
@SlotSpacing = 8;

@SpellSlotStyle = TextButtonStyle(
  Sounds: $Sounds.@ButtonsLight,
  Default: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileDefault.png", Border: 8)
  ),
  Hovered: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileHovered.png", Border: 8)
  ),
  Pressed: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileHovered.png", Border: 8)
  )
);

@SpellSlotSelectedStyle = TextButtonStyle(
  Sounds: $Sounds.@ButtonsLight,
  Default: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileSelected.png", Border: 8)
  ),
  Hovered: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileSelected.png", Border: 8)
  ),
  Pressed: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileSelected.png", Border: 8)
  )
);

@SpellSlotEmptyStyle = TextButtonStyle(
  Sounds: $Sounds.@ButtonsLight,
  Default: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileDefault.png", Border: 8)
  ),
  Hovered: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileDefault.png", Border: 8)
  ),
  Pressed: (
    LabelStyle: (Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center),
    Background: (TexturePath: "Tiles/TileDefault.png", Border: 8)
  )
);

$C.@PageOverlay #SpellbookPanel {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Height: 750, Width: 1050);

    #Title {
      Group {
        LayoutMode: Center;

        Label #TitleLabel {
          Style: (...@TitleStyle, FontName: "Default", LetterSpacing: 0.5);
          Text: "";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 9);

      Group #TabBar {
        LayoutMode: Left;
        Anchor: (Height: 40);
        Padding: (Horizontal: 16, Bottom: 8);

        $C.@TextButton #TabSpellsActive {
          Anchor: (Width: 140, Height: 36);
          Visible: false;
          Text: "SPELLS";
        }

        $C.@SecondaryTextButton #TabSpellsInactive {
          Anchor: (Width: 140, Height: 36);
          Visible: false;
          Text: "SPELLS";
        }

        Group { Anchor: (Width: 8); }

        $C.@TextButton #TabEnchantmentsActive {
          Anchor: (Width: 180, Height: 36);
          Visible: false;
          Text: "ENCHANTMENTS";
        }

        $C.@SecondaryTextButton #TabEnchantmentsInactive {
          Anchor: (Width: 180, Height: 36);
          Visible: false;
          Text: "ENCHANTMENTS";
        }
      }

      Group {
        LayoutMode: Left;
        FlexWeight: 1;

        Group #LeftPanel {
          LayoutMode: Top;
          FlexWeight: 1;
          Padding: (Left: 16, Right: 8, Vertical: 12);

          Group #CategoryHeader {
            LayoutMode: Left;
            Anchor: (Height: 30);

            Label #CategoryTitle {
              Style: (...@TitleStyle, TextColor: #89899f);
              Text: "";
            }

            Group { FlexWeight: 1; }

            Label #SpellCount {
              Style: (...@TitleStyle, TextColor: #89899f);
              Text: "0/9";
            }
          }

          Group #SpellGrid {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            FlexWeight: 1;
            Padding: (Top: 8);

            Group #SlotContainer {
              LayoutMode: LeftCenterWrap;
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Top: 12, Height: 50);

            $C.@SecondaryTextButton #CloseButton {
              Anchor: (Width: 140, Height: 42);
              Text: "";
            }
          }
        }

        Group #RightPanel {
          LayoutMode: Top;
          FlexWeight: 1;
          Padding: (Right: 16, Left: 8, Vertical: 12);

          Group #DetailsBackground {
            Background: (TexturePath: "ContainerBackgroundSecondary.png", Border: 23);
            LayoutMode: Top;
            FlexWeight: 1;
            Padding: (Full: 16);

            Label #SpellName {
              Style: (...@SpellTitleStyle, HorizontalAlignment: Center, Wrap: true);
              Anchor: (Height: 35);
              Text: "";
            }

            Group {
              Anchor: (Height: 200);
              LayoutMode: Middle;

              Group #SpellIconContainer {
                Anchor: (Width: 144, Height: 176);
                Background: (TexturePath: "Tiles/TileDefault.png", Border: 8);

                Group {
                  LayoutMode: Middle;
                  Anchor: (Full: 0);
                  Group #SpellIcon {
                    Anchor: (Width: 100, Height: 100);
                  }
                }
              }
            }

            Group #StatsSection {
              LayoutMode: Top;
              Padding: (Horizontal: 8, Top: 8);

              Group {
                LayoutMode: Left;
                Anchor: (Height: 26);

                Label #TypeLabel {
                  Style: @StatLabelStyle;
                  Text: "";
                }
                Group { FlexWeight: 1; }
                Label #TypeValue {
                  Style: (...@StatValueStyle, TextColor: #c9a227);
                  Text: "-";
                }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 26);

                Label #ManaLabel {
                  Style: @StatLabelStyle;
                  Text: "";
                }
                Group { FlexWeight: 1; }
                Label #ManaValue {
                  Style: (...@StatValueStyle, TextColor: #4dabf7);
                  Text: "-";
                }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 26);

                Label #CooldownLabel {
                  Style: @StatLabelStyle;
                  Text: "";
                }
                Group { FlexWeight: 1; }
                Label #CooldownValue {
                  Style: (...@StatValueStyle, TextColor: #adb5bd);
                  Text: "-";
                }
              }

              Group #EffectRow {
                LayoutMode: Left;
                Anchor: (Height: 26);

                Label #EffectLabel {
                  Style: @StatLabelStyle;
                  Text: "";
                }
                Group { FlexWeight: 1; }
                Label #EffectValue {
                  Style: (...@StatValueStyle, TextColor: #ff6b6b);
                  Text: "-";
                }
              }

              Group #RangeRow {
                LayoutMode: Left;
                Anchor: (Height: 26);

                Label #RangeLabel {
                  Style: @StatLabelStyle;
                  Text: "";
                }
                Group { FlexWeight: 1; }
                Label #RangeValue {
                  Style: (...@StatValueStyle, TextColor: #55ff55);
                  Text: "-";
                }
              }
            }

            Group {
              FlexWeight: 1;
              Padding: (Top: 8);

              Label #SpellDescription {
                Style: (FontSize: 12, TextColor: #b7cedd, Wrap: true, VerticalAlignment: Start, HorizontalAlignment: Center);
                Text: "";
              }
            }

            Group {
              LayoutMode: Top;
              Padding: (Horizontal: 16);

              $C.@TextButton #SelectButton {
                Anchor: (Height: 40);
                Text: "";
              }

              Group { Anchor: (Height: 8); }

              $C.@SecondaryTextButton #WriteScrollButton {
                Anchor: (Height: 40);
                Text: "";
              }
            }
          }
        }
      }
    }
  }
}
