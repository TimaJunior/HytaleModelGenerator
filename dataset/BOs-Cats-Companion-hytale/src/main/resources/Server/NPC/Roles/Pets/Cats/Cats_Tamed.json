{
  "Type": "Generic",
  "StartState": "Pet",
  "DefaultSubState": "Default",
  "DefaultNPCAttitude": "Friendly",
  "DefaultPlayerAttitude": "Friendly",
  "Appearance": {
    "Compute": "Appearance"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 6,
      "RunThreshold": 0.7,
      "RunThresholdRange": 0.1,
      "Gravity": 10,
      "MaxFallSpeed": 20,
      "Acceleration": 12
    }
  ],
  "MaxHealth": {
    "Compute": "MaxHealth"
  },
  "InteractionVars": {
    "Melee_Start": {
      "Interactions": [
        {
          "$Comment": "Cat melee attack animation and timing configuration",
          "Parent": "NPC_Attack_Melee_Simple",
          "Effects": {
            "ItemPlayerAnimationsId": "Fox_Default",
            "ItemAnimationId": "Attack"
          },
          "RunTime": 0.25
        }
      ]
    },
    "Melee_Damage": {
      "Interactions": [
        {
          "$Comment": "Pounce deals no damage - playful animation only",
          "Parent": "NPC_Attack_Melee_Damage",
          "DamageCalculator": {
            "Type": "Absolute",
            "BaseDamage": {
              "Physical": 0
            },
            "RandomPercentageModifier": 0
          }
        }
      ]
    }
  },
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "Cat is tamed - use substates for different behaviors",
          "Sensor": {
            "Type": "State",
            "State": "Pet"
          },
          "Instructions": [
            {
              "$Comment": "Day/night cycle - cats sleep at night automatically",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "Time",
                    "Period": [17.99, 6.01]
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Sleeping"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".GoingToBed"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Attacking"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Dying"
                    }
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Sleeping"
                }
              ]
            },
            {
              "$Comment": "Greet owner when nearby (cooldown via alarm to prevent spam)",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "CatOwner"
                  },
                  {
                    "Type": "Alarm",
                    "Name": "Greet_Ready",
                    "State": "Unset"
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Sleeping"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Attacking"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Fleeing"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Dying"
                    }
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Greeting"
                }
              ]
            },
            {
              "$Comment": "Clear greeting alarm when it has passed",
              "Continue": true,
              "Sensor": {
                "Type": "Alarm",
                "Name": "Greet_Ready",
                "State": "Passed",
                "Clear": true
              },
              "Actions": [
                {
                  "Type": "Nothing"
                }
              ]
            },
            {
              "$Comment": "Flee from hostile mobs - cats run away from danger",
              "Sensor": {
                "Type": "And",
                "Sensors": [
                  {
                    "Type": "Mob",
                    "Range": 8,
                    "Filters": [
                      {
                        "Type": "Attitude",
                        "Attitudes": ["Hostile"]
                      }
                    ]
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Fleeing"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Attacking"
                    }
                  },
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "State",
                      "State": ".Dying"
                    }
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Fleeing"
                }
              ]
            },
            {
              "$Comment": "Sitting behavior - auto switches to waiting after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".Sitting"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Sit",
                  "Slot": "Action"
                },
                {
                  "Type": "Timeout",
                  "Delay": [10, 20],
                  "Action": {
                    "Type": "State",
                    "State": ".Waiting"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Sleeping behavior - auto switches to waiting after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".Sleeping"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Sleep",
                  "Slot": "Action"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Fox_Sleep"
                },
                {
                  "Type": "Timeout",
                  "Delay": [15, 30],
                  "Action": {
                    "Type": "State",
                    "State": ".Waiting"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "GoingToBed behavior - walks to bed using TransientPath, teleports after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".GoingToBed"
              },
              "Instructions": [
                {
                  "$Comment": "Follow path to bed while path exists, teleport after 4-5 sec timeout",
                  "Sensor": {
                    "Type": "Path",
                    "PathType": "TransientPath"
                  },
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [4, 5],
                      "Action": {
                        "Type": "CatTeleportToBed"
                      }
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Path"
                  }
                },
                {
                  "$Comment": "No path - teleport immediately to bed",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "CatTeleportToBed"
                    },
                    {
                      "Type": "State",
                      "State": ".Sleeping"
                    }
                  ]
                }
              ]
            },
            {
              "$Comment": "Stretching behavior - auto switches to waiting after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".Stretching"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Stretch",
                  "Slot": "Action"
                },
                {
                  "Type": "Timeout",
                  "Delay": [10, 20],
                  "Action": {
                    "Type": "State",
                    "State": ".Waiting"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Licking behavior - auto switches to waiting after timeout",
              "Sensor": {
                "Type": "State",
                "State": ".Licking"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Lick",
                  "Slot": "Action"
                },
                {
                  "Type": "Timeout",
                  "Delay": [15, 30],
                  "Action": {
                    "Type": "State",
                    "State": ".Waiting"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Playing behavior - auto-returns to default after 3-6 seconds",
              "Sensor": {
                "Type": "State",
                "State": ".Playing"
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Swing_Left",
                  "Slot": "Action"
                },
                {
                  "Type": "Timeout",
                  "Delay": [3, 6],
                  "Action": {
                    "Type": "State",
                    "State": ".Default"
                  }
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Searching behavior with movement",
              "Sensor": {
                "Type": "State",
                "State": ".Searching"
              },
              "Instructions": [
                {
                  "$Comment": "Reset animation first",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Search",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "WanderInCircle",
                    "RelativeSpeed": 0.3
                  }
                }
              ]
            },
            {
              "$Comment": "Attacking behavior - attacks commanded target",
              "Sensor": {
                "Type": "State",
                "State": ".Attacking"
              },
              "Instructions": [
                {
                  "$Comment": "Chase and attack target",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": 20
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Alerted",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 4,
                    "StopDistance": 2,
                    "RelativeSpeed": 1.0
                  }
                },
                {
                  "$Comment": "Execute attack when in range",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": 2.5
                  },
                  "ActionsBlocking": true,
                  "Actions": [
                    {
                      "Type": "Attack",
                      "Attack": "Root_NPC_Attack_Melee",
                      "AttackPauseRange": [1.5, 2]
                    },
                    {
                      "Type": "Timeout",
                      "Delay": [1, 1.5]
                    }
                  ]
                },
                {
                  "$Comment": "No target found - go back to default behavior",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "State",
                      "State": ".Default"
                    }
                  ]
                }
              ]
            },
            {
              "$Comment": "Fleeing behavior - runs away from hostile entities",
              "Sensor": {
                "Type": "State",
                "State": ".Fleeing"
              },
              "Instructions": [
                {
                  "$Comment": "Flee from nearby hostile entity",
                  "Sensor": {
                    "Type": "Mob",
                    "Range": 12,
                    "Filters": [
                      {
                        "Type": "Attitude",
                        "Attitudes": ["Hostile"]
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Run",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Flee",
                    "RelativeSpeed": 1.2
                  }
                },
                {
                  "$Comment": "No more threats nearby - return to waiting",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "Timeout",
                      "Delay": [2, 4],
                      "Action": {
                        "Type": "State",
                        "State": ".Waiting"
                      }
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                }
              ]
            },
            {
              "$Comment": "Greeting behavior - cat greets owner with animation, then cooldown",
              "Sensor": {
                "Type": "State",
                "State": ".Greeting"
              },
              "Instructions": [
                {
                  "$Comment": "Play greeting animation and set cooldown alarm",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Alerted",
                      "Slot": "Status"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Fox_Run"
                    },
                    {
                      "Type": "SpawnParticles",
                      "Offset": [0, 0.8, 0],
                      "ParticleSystem": "Hearts_Subtle"
                    }
                  ]
                },
                {
                  "$Comment": "Watch owner during greeting, then return to default",
                  "Sensor": {
                    "Type": "CatOwner"
                  },
                  "Actions": [
                    {
                      "Type": "Timeout",
                      "Delay": [3, 6],
                      "Action": {
                        "Type": "Sequence",
                        "Actions": [
                          {
                            "Type": "SetAlarm",
                            "Name": "Greet_Ready",
                            "DurationRange": ["PT2H", "PT12H"]
                          },
                          {
                            "Type": "State",
                            "State": ".Default"
                          }
                        ]
                      }
                    }
                  ],
                  "BodyMotion": {
                    "Type": "Nothing"
                  }
                },
                {
                  "$Comment": "Owner not nearby anymore - end greeting early",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "SetAlarm",
                      "Name": "Greet_Ready",
                      "DurationRange": ["PT2H", "PT12H"]
                    },
                    {
                      "Type": "State",
                      "State": ".Default"
                    }
                  ]
                }
              ]
            },
            {
              "$Comment": "Waiting behavior",
              "Sensor": {
                "Type": "State",
                "State": ".Waiting"
              },
              "Actions": [
                {
                  "Type": "PlayAnimation",
                  "Animation": "Idle",
                  "Slot": "Action"
                }
              ],
              "BodyMotion": {
                "Type": "Nothing"
              }
            },
            {
              "$Comment": "Wandering behavior",
              "Sensor": {
                "Type": "State",
                "State": ".Wandering"
              },
              "Instructions": [
                {
                  "$Comment": "Reset animation first",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    },
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Chicken_Walk"
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ],
                  "BodyMotion": {
                    "Type": "WanderInCircle",
                    "RelativeSpeed": 0.5
                  }
                }
              ]
            },
            {
              "$Comment": "Default following behavior with pauses",
              "Sensor": {
                "Type": "State",
                "State": ".Default"
              },
              "Instructions": [
                {
                  "$Comment": "Reset animation first when entering this state",
                  "Sensor": {
                    "Type": "Any",
                    "Once": true
                  },
                  "Actions": [
                    {
                      "Type": "PlayAnimation",
                      "Animation": "Idle",
                      "Slot": "Action"
                    }
                  ]
                },
                {
                  "$Comment": "Random following behavior - sometimes with pauses, sometimes continuous",
                  "Sensor": {
                    "Type": "Any"
                  },
                  "Type": "Random",
                  "ExecuteFor": [60, 120],
                  "Instructions": [
                    {
                      "$Comment": "Active following with short pauses",
                      "Weight": 40,
                      "Sensor": {
                        "Type": "Player",
                        "Range": 18,
                        "LockOnTarget": true
                      },
                      "Actions": [
                        {
                          "Type": "PlayAnimation",
                          "Animation": "Idle",
                          "Slot": "Action"
                        }
                      ],
                      "BodyMotion": {
                        "Type": "Sequence",
                        "Looped": true,
                        "Motions": [
                          {
                            "Type": "Timer",
                            "Time": [4, 6],
                            "Motion": {
                              "Type": "Seek",
                              "SlowDownDistance": 5,
                              "StopDistance": 3,
                              "RelativeSpeed": 0.8
                            }
                          },
                          {
                            "Type": "Timer",
                            "Time": [0.5, 1.5],
                            "Motion": {
                              "Type": "Nothing"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "$Comment": "Continuous following without pauses",
                      "Weight": 60,
                      "Sensor": {
                        "Type": "Player",
                        "Range": 18,
                        "LockOnTarget": true
                      },
                      "Actions": [
                        {
                          "Type": "PlayAnimation",
                          "Animation": "Idle",
                          "Slot": "Action"
                        }
                      ],
                      "BodyMotion": {
                        "Type": "Seek",
                        "SlowDownDistance": 5,
                        "StopDistance": 3,
                        "RelativeSpeed": 0.8
                      }
                    }
                  ]
                },
                {
                  "$Comment": "Teleport to player if too far away (outside seek range)",
                  "Sensor": {
                    "Type": "Target"
                  },
                  "BodyMotion": {
                    "Type": "Teleport"
                  }
                }
              ]
            },
            {
              "$Comment": "Dying behavior - plays death animation",
              "Sensor": {
                "Type": "State",
