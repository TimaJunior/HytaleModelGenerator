  "InteractionInstruction": {
    "Instructions": [
      {
        "$Comment": "Tamed cat + Owner holding carrier - show capture/release hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {"Type": "CatOwner"},
            {"Type": "IsHoldingCarrier"}
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
