            "Hint": "cats.interactions.hint.carrier",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Tamed cat + Owner (no carrier) - show owner interaction hint",
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {"Type": "CatOwner"},
            {"Type": "Not", "Sensor": {"Type": "IsHoldingCarrier"}}
          ]
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "cats.interactions.hint.owner",
            "ShowPrompt": true
          }
        ]
      },
      {
        "$Comment": "Tamed cat + Stranger - no interaction allowed",
        "Continue": true,
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "CatOwner"
          }
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": false,
            "ShowPrompt": false
          }
        ]
      },
      {
        "$Comment": "Interaction handlers - check owner first, then stranger",
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Actions": [
          {
            "Type": "LockOnInteractionTarget"
          },
          {
            "Type": "CatInteractionOwner"
          },
          {
            "Type": "CatInteractionStranger"
          }
        ]
      }
    ]
  },
